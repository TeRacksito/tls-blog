services:
  postgres:
    image: postgres:16
    mem_limit: 512m
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: tls_blog
    ports:
      - "5432:5432"
    networks:
      - prisma-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d tls_blog"]
      interval: 5s
      timeout: 2s
      retries: 20
    volumes:
      - pg_data_local:/var/lib/postgresql/data
    command: >
      bash -c "docker-entrypoint.sh postgres && psql -U postgres -d tls_blog -c 'CREATE EXTENSION IF NOT EXISTS pg_trgm;'"
    logging:
      options:
        max-size: "10m"
        max-file: "3"

  dbgate:
    image: dbgate/dbgate
    container_name: dbgate_web
    restart: always
    ports:
      - "8081:3000"
    environment:
      CONNECTIONS: postgres_db
      LABEL_postgres_db: "TLS Blog DB"
      SERVER_postgres_db: postgres
      USER_postgres_db: postgres
      PASSWORD_postgres_db: postgres
      DATABASE_postgres_db: tls_blog
      ENGINE_postgres_db: postgres@dbgate-plugin-postgres
    networks:
      - prisma-network
    depends_on:
      postgres:
        condition: service_healthy

networks:
  prisma-network:

volumes:
  pg_data_local:
